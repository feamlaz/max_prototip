# Credentials of a real GREEN-API MAX instance.
# Copy this file to `.env.local` and fill in the values if you do not want to
# type them in the UI. NOTE: this prototype keeps credentials in
# localStorage (key `max-prototype:credentials`). The VITE_* variables are read
# at startup as DEFAULTS FOR EMPTY FIELDS ONLY — a value already saved in
# localStorage (or typed by the user) always wins, so this file can never
# silently redirect a working instance.

# GREEN-API console: https://green-api.com/en/panel
# apiUrl — base address of the API, e.g. https://api.green-api.com
VITE_GREEN_API_URL=https://api.green-api.com

# idInstance — numeric instance id from the GREEN-API panel
VITE_GREEN_API_ID_INSTANCE=

# apiTokenInstance — API token from the GREEN-API panel
VITE_GREEN_API_TOKEN_INSTANCE=

# Start in demo mode (no credentials needed). true | false
VITE_DEMO_MODE=false
